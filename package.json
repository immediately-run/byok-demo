{
  "name": "byok-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Minimal end-to-end exercise of §6 injectSecret: grant this app the OpenRouter key you stored in Settings, then call OpenRouter browser-direct with the key injected by the host as Authorization: Bearer (the app never sees the value).",
  "immediately.run": {
    "requireLatest": "stale_ok",
    "requests": {
      "net:fetch": {
        "required": true,
        "hosts": [
          {
            "origin": "https://openrouter.ai",
            "paths": ["/api/v1/"],
            "methods": ["POST"],
            "injectSecret": { "type": "bearer-token" }
          }
        ]
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@immediately-run/sdk": "^0.93.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.9"
  }
}
